<Application x:Class="Veyra.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Veyra.UI.ViewModels"
             xmlns:views="clr-namespace:Veyra.UI.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Tokens.xaml" />
                <ResourceDictionary Source="Theme/Controls.xaml" />
                <ResourceDictionary Source="Theme/Controls2.xaml" />
                <ResourceDictionary Source="Theme/Controls3.xaml" />
                <ResourceDictionary Source="Theme/Layout.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <DataTemplate DataType="{x:Type vm:DisplayViewModel}">
                <views:DisplayView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ResolutionViewModel}">
                <views:ResolutionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MonitorViewModel}">
                <views:MonitorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CustomizeViewModel}">
                <views:CustomizeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CrosshairViewModel}">
                <views:CrosshairView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
                <views:ProfilesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MoreViewModel}">
                <views:MoreView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
