<Application x:Class="Veyra.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Veyra.UI.ViewModels"
             xmlns:views="clr-namespace:Veyra.UI.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Tokens.xaml" />
                <ResourceDictionary Source="Theme/Controls.xaml" />
                <ResourceDictionary Source="Theme/Controls2.xaml" />
                <ResourceDictionary Source="Theme/Controls3.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
                <views:OverviewView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DisplaysViewModel}">
                <views:DisplaysView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ColoursViewModel}">
                <views:ColoursView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CrosshairViewModel}">
                <views:CrosshairView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PerformanceViewModel}">
                <views:PerformanceView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HotkeysViewModel}">
                <views:HotkeysView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
