<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- UI v2 palette: deep blue-black surfaces, restrained cyan accent, clear borders. -->
    <Color x:Key="BgColor">#070C11</Color>
    <Color x:Key="SurfaceColor">#0B141B</Color>
    <Color x:Key="SurfaceRaisedColor">#101C24</Color>
    <Color x:Key="SurfaceHoverColor">#152630</Color>
    <Color x:Key="BorderColor">#1C2D37</Color>
    <Color x:Key="BorderStrongColor">#2B4450</Color>
    <Color x:Key="TextColor">#F3FAFC</Color>
    <Color x:Key="TextMutedColor">#A7BCC6</Color>
    <Color x:Key="TextFaintColor">#718893</Color>
    <Color x:Key="AccentColor">#5BC8E8</Color>
    <Color x:Key="AccentBrightColor">#8BE4F8</Color>
    <Color x:Key="AccentSoftColor">#0C2531</Color>
    <Color x:Key="PinkColor">#67E8F9</Color>
    <Color x:Key="BlueColor">#60A5FA</Color>
    <Color x:Key="NavSelectedColor">#102A35</Color>
    <Color x:Key="SuccessColor">#5AD6B3</Color>
    <Color x:Key="WarningColor">#E8B45C</Color>
    <Color x:Key="DangerColor">#F07A86</Color>
    <Color x:Key="SidebarTextColor">#F3FAFC</Color>
    <Color x:Key="SidebarMutedColor">#9EB4BE</Color>
    <Color x:Key="SidebarFaintColor">#6D838D</Color>
    <Color x:Key="OceanAccentColor">#5BC8E8</Color>
    <Color x:Key="OceanBrightColor">#8BE4F8</Color>
    <Color x:Key="SidebarBorderColor">#17262F</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource TextFaintColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentBrightBrush" Color="{StaticResource AccentBrightColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="PinkBrush" Color="{StaticResource PinkColor}" />
    <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource BlueColor}" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="{StaticResource NavSelectedColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource SidebarTextColor}" />
    <SolidColorBrush x:Key="SidebarMutedBrush" Color="{StaticResource SidebarMutedColor}" />
    <SolidColorBrush x:Key="SidebarFaintBrush" Color="{StaticResource SidebarFaintColor}" />
    <SolidColorBrush x:Key="SidebarAccentBrush" Color="{StaticResource OceanAccentColor}" />
    <SolidColorBrush x:Key="SidebarAccentBrightBrush" Color="{StaticResource OceanBrightColor}" />
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="{StaticResource SidebarBorderColor}" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#0F1D25" />
    <SolidColorBrush x:Key="SidebarCardBrush" Color="#0B171E" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#29151A" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#62313A" />

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#67D5EE" />
        <GradientStop Offset="1" Color="#3FAECB" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TitleGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#FFFFFF" />
        <GradientStop Offset="1" Color="#D6EFF6" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#0C161E" />
        <GradientStop Offset="1" Color="#0A131A" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardHoverGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#12242E" />
        <GradientStop Offset="1" Color="#0A151C" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#0E2A36" />
        <GradientStop Offset="1" Color="#09141B" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#0B151C" />
        <GradientStop Offset="0.55" Color="#081118" />
        <GradientStop Offset="1" Color="#060C11" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarActiveGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#112C37" />
        <GradientStop Offset="1" Color="#0B1C24" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="NavActiveGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#0F2A35" />
        <GradientStop Offset="1" Color="#0A1A22" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LogoGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#E8FBFF" />
        <GradientStop Offset="0.55" Color="#6FD6ED" />
        <GradientStop Offset="1" Color="#2E9DBD" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="StatusBarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#081117" />
        <GradientStop Offset="1" Color="#05090D" />
    </LinearGradientBrush>

    <!-- Kept for resource compatibility; the new UI does not use glows on controls. -->
    <DropShadowEffect x:Key="CardShadowEffect" Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.28" />
    <DropShadowEffect x:Key="CardHoverEffect" Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.3" />
    <DropShadowEffect x:Key="AccentGlowEffect" Color="#5BC8E8" BlurRadius="12" ShadowDepth="0" Opacity="0.22" />
    <DropShadowEffect x:Key="SidebarGlowEffect" Color="#5BC8E8" BlurRadius="10" ShadowDepth="0" Opacity="0.18" />
    <DropShadowEffect x:Key="StrongGlowEffect" Color="#5BC8E8" BlurRadius="18" ShadowDepth="0" Opacity="0.3" />
    <DropShadowEffect x:Key="SuccessGlowEffect" Color="#5AD6B3" BlurRadius="8" ShadowDepth="0" Opacity="0.35" />
    <DropShadowEffect x:Key="SoftGlowEffect" Color="#60A5FA" BlurRadius="14" ShadowDepth="0" Opacity="0.2" />

    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style TargetType="{x:Type UserControl}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="Eyebrow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="MaxWidth" Value="650" />
        <Setter Property="Margin" Value="0,7,0,0" />
    </Style>

    <Style x:Key="PageContent" TargetType="StackPanel">
        <Setter Property="Margin" Value="30,24,30,32" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
    </Style>

    <Style x:Key="Value" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="19" />
    </Style>

    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style x:Key="Micro" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrightBrush}" />
    </Style>

    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background" Value="#0B1B22" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
