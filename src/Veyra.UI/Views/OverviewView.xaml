<UserControl x:Class="Veyra.UI.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageContent}">
            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#10201E" BorderBrush="#26544C"
                        BorderThickness="1" CornerRadius="20" Padding="11,6" Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}"
                                 Effect="{StaticResource SuccessGlowEffect}" VerticalAlignment="Center" />
                        <TextBlock Text="SYSTEM READY" FontSize="9" FontWeight="Bold" Margin="7,0,0,0"
                                   Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Background="{StaticResource HeroGradientBrush}"
                    BorderBrush="#1B5B70" Padding="28,26" Margin="0,24,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="176" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#0A2B3B" BorderBrush="#1B5C73" BorderThickness="1" CornerRadius="5"
                                    Padding="8,3">
                                <TextBlock Text="GPU DRIVER COLOUR" Style="{StaticResource Micro}" />
                            </Border>
                            <Border Background="#13221F" BorderBrush="#26544C" BorderThickness="1" CornerRadius="5"
                                    Padding="8,3" Margin="8,0,0,0">
                                <TextBlock Text="RESTORE READY" Style="{StaticResource Micro}"
                                           Foreground="{StaticResource SuccessBrush}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding ColourStatus}" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap" Margin="0,18,24,0" />
                        <TextBlock Text="{Binding Recovery}" Style="{StaticResource Caption}" Margin="0,8,24,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                            <StackPanel>
                                <TextBlock Text="DISPLAYS" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding DisplayCount}" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                            <Border Width="1" Height="34" Background="{StaticResource BorderStrongBrush}"
                                    Margin="28,0" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="COLOUR TARGET" Style="{StaticResource Label}" />
                                <TextBlock Text="Per display" FontSize="14" FontWeight="SemiBold"
                                           Margin="0,7,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Column="1" Width="158" Height="158" HorizontalAlignment="Right"
                          VerticalAlignment="Center">
                        <Ellipse Fill="#061C28" Stroke="#154A60" StrokeThickness="1" />
                        <Ellipse Width="116" Height="116" Stroke="#1B607A" StrokeThickness="1" />
                        <Ellipse Width="86" Height="86" Fill="{StaticResource LogoGradientBrush}"
                                 Effect="{StaticResource StrongGlowEffect}" />
                        <TextBlock Text="V" FontFamily="{StaticResource DisplayFont}" FontSize="35" FontWeight="Bold"
                                   Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrightBrush}"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,23,0"
                                 Effect="{StaticResource AccentGlowEffect}" />
                        <Ellipse Width="5" Height="5" Fill="{StaticResource BlueBrush}"
                                 HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="29,0,0,25" />
                    </Grid>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource AccentSoftBrush}"
                                        BorderBrush="#1B4E61" BorderThickness="1">
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Foreground="{StaticResource AccentBrightBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="GPU SUPPORT" Style="{StaticResource SectionTitle}"
                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="Saturation is applied by the GPU driver. Brightness, contrast, gamma and temperature use the Windows ramp."
                                       Style="{StaticResource Caption}" Margin="0,8,0,0" MaxWidth="650"
                                       HorizontalAlignment="Left" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#10201E"
                                BorderBrush="#26544C" BorderThickness="1" CornerRadius="18" Padding="11,6"
                                Margin="0,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="WINDOWS 10 22H2 · VERIFIED" FontSize="8.5" FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}" Margin="6,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,15,0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="NVIDIA" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Border Background="#0A2B3B" BorderBrush="#1B5C73" BorderThickness="1"
                                        CornerRadius="4" Padding="7,2" Margin="8,0,0,0">
                                    <TextBlock Text="IMPLEMENTED" FontSize="8" FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrightBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Digital Vibrance through NVAPI on supported NVIDIA GPUs and drivers."
                                       Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="Hardware verification still pending." FontSize="10.5"
                                       Foreground="{StaticResource TextFaintBrush}" Margin="0,5,0,0" />
                        </StackPanel>

                        <Border Grid.Column="1" Background="{StaticResource BorderBrush}" />

                        <StackPanel Grid.Column="2" Margin="20,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="AMD RADEON" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Border Background="#10201E" BorderBrush="#26544C" BorderThickness="1"
                                        CornerRadius="4" Padding="7,2" Margin="8,0,0,0">
                                    <TextBlock Text="VERIFIED" FontSize="8" FontWeight="Bold"
                                               Foreground="{StaticResource SuccessBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Real driver saturation through ADL2 on Radeon GPUs and integrated Radeon graphics."
                                       Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="RX 7800 XT verified; Ryzen APUs not yet tested." FontSize="10.5"
                                       Foreground="{StaticResource TextFaintBrush}" Margin="0,5,0,0" />
                        </StackPanel>

                        <Border Grid.Column="3" Background="{StaticResource BorderBrush}" />

                        <StackPanel Grid.Column="4" Margin="20,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="INTEL" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Border Background="#101A20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="7,2" Margin="8,0,0,0">
                                    <TextBlock Text="LIMITED" FontSize="8" FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Windows ramp controls work, but Intel integrated graphics have no driver saturation in 1.0.0."
                                       Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="Brightness, contrast, gamma and temperature only." FontSize="10.5"
                                       Foreground="{StaticResource TextFaintBrush}" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="On hybrid laptops, only the GPU driving the display can be controlled. HDR and Windows 11 are not verified."
                               FontSize="10.5" Foreground="{StaticResource TextFaintBrush}" Margin="0,14,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
