<UserControl x:Class="Veyra.UI.Views.DisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageContent}">

            <!-- Page header -->
            <Border Style="{StaticResource Panel}" Padding="24,18">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Border Background="#10201E" BorderBrush="#26544C" BorderThickness="1" CornerRadius="6" Padding="9,5" Margin="0,2,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Live" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"
                                           Margin="6,0,0,0" />
                            </StackPanel>
                        </Border>
                        <Button Content="Reset" Style="{StaticResource GhostButton}" Click="Reset_Click" Margin="0,0,8,0" />
                        <Button Content="Restore original" Style="{StaticResource PrimaryButton}" Click="Restore_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Display picker -->
            <Border Style="{StaticResource Panel}" Padding="20,12" Margin="0,10,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DisplayMeta}" Style="{StaticResource Tiny}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Displays}" SelectedItem="{Binding SelectedDisplay}"
                             HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource Chip}">
                                <Setter Property="Margin" Value="6,0,0,0" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding FriendlyName}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FriendlyName}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <!-- Saturation and gamma -->
                    <Border Style="{StaticResource Panel}" Padding="24,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Saturation" Style="{StaticResource SectionTitle}" />
                                            <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="#1B5C73" BorderThickness="1"
                                                    CornerRadius="6" Padding="6,2" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding SaturationProviderLabel}" FontSize="8" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentBrightBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="100 is the game as it ships" Style="{StaticResource Tiny}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Saturation, StringFormat={}{0:0}}" Style="{StaticResource BigNumber}" />
                                    <TextBlock Text="%" FontSize="22" Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Bottom" Margin="3,0,0,8" />
                                </StackPanel>

                                <Slider Minimum="0" Maximum="{Binding SaturationMaximum}"
                                        Value="{Binding Saturation}" IsEnabled="{Binding SaturationEnabled}" Margin="0,10,0,0" />
                                <Grid Margin="0,2,0,0">
                                    <TextBlock Text="0" Style="{StaticResource Tiny}" />
                                    <TextBlock Text="100" Style="{StaticResource Tiny}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding SaturationMaximum, StringFormat={}{0:0}}" Style="{StaticResource Tiny}"
                                               HorizontalAlignment="Right" />
                                </Grid>

                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SaturationOn}"
                                          IsEnabled="{Binding SaturationEnabled}" Content="Driver saturation on"
                                          Margin="0,14,0,0" />
                            </StackPanel>

                            <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}" Margin="16,0" />

                            <StackPanel Grid.Column="2">
                                <Grid>
                                    <TextBlock Text="Gamma" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="1.00 is neutral" Style="{StaticResource Tiny}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Gamma, StringFormat={}{0:0.00}}" Style="{StaticResource BigNumber}" />
                                </StackPanel>

                                <Slider Minimum="0.5" Maximum="2.5" Value="{Binding Gamma}" Margin="0,10,0,0" />
                                <Grid Margin="0,2,0,0">
                                    <TextBlock Text="0.50" Style="{StaticResource Tiny}" />
                                    <TextBlock Text="1.00" Style="{StaticResource Tiny}" HorizontalAlignment="Center" />
                                    <TextBlock Text="2.50" Style="{StaticResource Tiny}" HorizontalAlignment="Right" />
                                </Grid>

                                <TextBlock Text="Ramp control" Style="{StaticResource Tiny}" Margin="0,16,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Fine tune -->
                    <Border Style="{StaticResource Panel}" Padding="24,20" Margin="0,10,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Fine tune" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Contrast, highlights and shadows also change how dark it looks, not just gamma."
                                           Style="{StaticResource Tiny}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Brightness" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding Brightness, StringFormat={}{0:0} %}" Style="{StaticResource FieldValue}" />
                                    </Grid>
                                    <Slider Minimum="-100" Maximum="100" Value="{Binding Brightness}" Margin="0,3,0,14" />

                                    <Grid>
                                        <TextBlock Text="Contrast" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding Contrast, StringFormat={}{0:0} %}" Style="{StaticResource FieldValue}" />
                                    </Grid>
                                    <Slider Minimum="-100" Maximum="100" Value="{Binding Contrast}" Margin="0,3,0,14" />

                                    <Grid>
                                        <TextBlock Text="Highlights" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding Shadow, StringFormat={}{0:0}}" Style="{StaticResource FieldValue}" />
                                    </Grid>
                                    <Slider Minimum="-100" Maximum="100" Value="{Binding Shadow}" Margin="0,3,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <Grid>
                                        <TextBlock Text="Temperature" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding Temperature, StringFormat={}{0:0} K}" Style="{StaticResource FieldValue}" />
                                    </Grid>
                                    <Slider Minimum="4000" Maximum="10000" Value="{Binding Temperature}" Margin="0,3,0,14" />

                                    <Grid>
                                        <TextBlock Text="Blacks" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding BlackLevel, StringFormat={}{0:0}}" Style="{StaticResource FieldValue}" />
                                    </Grid>
                                    <Slider Minimum="0" Maximum="50" Value="{Binding BlackLevel}" Margin="0,3,0,14" />

                                    <Grid>
                                        <TextBlock Text="Red tint" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding RedTint, StringFormat={}{0:+0;-0;0}}" Style="{StaticResource FieldValue}" />
                                    </Grid>
                                    <Slider Minimum="-50" Maximum="50" Value="{Binding RedTint}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding SaturationReason}" Style="{StaticResource Caption}" Margin="0,16,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Scene presets -->
                <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="20,18" Margin="10,0,0,0"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Scene presets" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Tap a card to apply" Style="{StaticResource Tiny}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Presets}" Margin="0,14,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PresetCardBorder}" Width="140" Margin="0,0,6,8"
                                            ToolTip="{Binding Description}"
                                            AutomationProperties.Name="{Binding Name}"
                                            MouseLeftButtonUp="Preset_Click">
                                        <StackPanel>
                                            <Border Height="58" CornerRadius="3" Background="{Binding Preview}" />
                                            <Grid Margin="0,7,0,0">
                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border HorizontalAlignment="Right" Background="{StaticResource AccentSoftBrush}" CornerRadius="4"
                                                        Padding="4,1">
                                                    <TextBlock Text="{Binding Badge}" FontSize="7" FontWeight="Bold"
                                                               Foreground="{StaticResource TextFaintBrush}" />
                                                </Border>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Swatches}" Margin="0,6,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="12" Height="5" CornerRadius="1" Background="{Binding}"
                                                                Margin="0,0,3,0" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,4,0,10" />
                        <TextBlock Text="Save the current sliders as a look" Style="{StaticResource Tiny}" />
                        <TextBox Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />
                        <Button Content="Save look" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                Margin="0,8,0,0" Click="SavePreset_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="2,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
