<UserControl x:Class="Veyra.UI.Views.DisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Veyra.UI.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageContent}">

            <controls:PageHeader Eyebrow="COLOUR" Title="{Binding Title}" Subtitle="{Binding Subtitle}">
                <controls:PageHeader.Actions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Badge}" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Live" Style="{StaticResource BadgeText}" Foreground="{StaticResource SuccessBrush}"
                                           Margin="6,0,0,0" />
                            </StackPanel>
                        </Border>
                        <Button Content="Reset" Style="{StaticResource GhostButton}" Click="Reset_Click" Margin="0,0,8,0" />
                        <Button Content="Restore original" Style="{StaticResource SecondaryButton}" Click="Restore_Click" />
                    </StackPanel>
                </controls:PageHeader.Actions>
            </controls:PageHeader>

            <!-- Display picker -->
            <Border Style="{StaticResource Panel}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding DisplayMeta}" Style="{StaticResource Tiny}" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                    <ListBox Grid.Column="1" ItemsSource="{Binding Displays}" SelectedItem="{Binding SelectedDisplay}"
                             HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource Chip}">
                                <Setter Property="Margin" Value="6,0,0,0" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding FriendlyName}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FriendlyName}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <!-- Saturation and gamma -->
                    <Border Style="{StaticResource Panel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Saturation" Style="{StaticResource SectionTitle}" Margin="0" />
                                    <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="#24586A" BorderThickness="1"
                                            CornerRadius="5" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SaturationProviderLabel}" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrightBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="100 is the game as it ships" Style="{StaticResource Tiny}"
                                           Margin="0,6,0,0" />

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Saturation, StringFormat={}{0:0}}" Style="{StaticResource BigNumber}" />
                                    <TextBlock Text="%" FontSize="20" Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Bottom" Margin="3,0,0,8" />
                                </StackPanel>

                                <Slider Minimum="0" Maximum="{Binding SaturationMaximum}"
                                        Value="{Binding Saturation}" IsEnabled="{Binding SaturationEnabled}" Margin="0,10,0,0" />
                                <Grid Margin="0,3,0,0">
                                    <TextBlock Text="0" Style="{StaticResource Tiny}" />
                                    <TextBlock Text="100" Style="{StaticResource Tiny}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding SaturationMaximum, StringFormat={}{0:0}}" Style="{StaticResource Tiny}"
                                               HorizontalAlignment="Right" />
                                </Grid>

                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SaturationOn}"
                                          IsEnabled="{Binding SaturationEnabled}" Content="Driver saturation on"
                                          Margin="0,14,0,0" />
                            </StackPanel>

                            <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}" Margin="14,0" />

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Gamma" Style="{StaticResource SectionTitle}" Margin="0" />
                                <TextBlock Text="1.00 is neutral" Style="{StaticResource Tiny}" Margin="0,6,0,0" />

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Gamma, StringFormat={}{0:0.00}}" Style="{StaticResource BigNumber}" />
                                </StackPanel>

                                <Slider Minimum="0.5" Maximum="2.5" Value="{Binding Gamma}" Margin="0,10,0,0" />
                                <Grid Margin="0,3,0,0">
                                    <TextBlock Text="0.50" Style="{StaticResource Tiny}" />
                                    <TextBlock Text="1.00" Style="{StaticResource Tiny}" HorizontalAlignment="Center" />
                                    <TextBlock Text="2.50" Style="{StaticResource Tiny}" HorizontalAlignment="Right" />
                                </Grid>

                                <TextBlock Text="Ramp control" Style="{StaticResource Tiny}" Margin="0,16,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Fine tune -->
                    <Border Style="{StaticResource Panel}" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Fine tune" Style="{StaticResource SectionTitle}" Margin="0" />
                                <TextBlock Text="Contrast, highlights and shadows also change how dark it looks, not just gamma."
                                           Style="{StaticResource Tiny}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Brightness" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding Brightness, StringFormat={}{0:0} %}" Style="{StaticResource FieldValue}" />
                                    </Grid>
                                    <Slider Minimum="-100" Maximum="100" Value="{Binding Brightness}" Margin="0,3,0,14" />

                                    <Grid>
                                        <TextBlock Text="Contrast" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding Contrast, StringFormat={}{0:0} %}" Style="{StaticResource FieldValue}" />
                                    </Grid>
                                    <Slider Minimum="-100" Maximum="100" Value="{Binding Contrast}" Margin="0,3,0,14" />

                                    <Grid>
                                        <TextBlock Text="Highlights" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding Shadow, StringFormat={}{0:0}}" Style="{StaticResource FieldValue}" />
                                    </Grid>
                                    <Slider Minimum="-100" Maximum="100" Value="{Binding Shadow}" Margin="0,3,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <Grid>
                                        <TextBlock Text="Temperature" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding Temperature, StringFormat={}{0:0} K}" Style="{StaticResource FieldValue}" />
                                    </Grid>
                                    <Slider Minimum="4000" Maximum="10000" Value="{Binding Temperature}" Margin="0,3,0,14" />

                                    <Grid>
                                        <TextBlock Text="Blacks" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding BlackLevel, StringFormat={}{0:0}}" Style="{StaticResource FieldValue}" />
                                    </Grid>
                                    <Slider Minimum="0" Maximum="50" Value="{Binding BlackLevel}" Margin="0,3,0,14" />

                                    <Grid>
                                        <TextBlock Text="Red tint" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding RedTint, StringFormat={}{0:+0;-0;0}}" Style="{StaticResource FieldValue}" />
                                    </Grid>
                                    <Slider Minimum="-50" Maximum="50" Value="{Binding RedTint}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding SaturationReason}" Style="{StaticResource Caption}" Margin="0,16,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Saved looks -->
                <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="18" Margin="12,0,0,0"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Saved looks" Style="{StaticResource SectionTitle}" Margin="0" />
                            <TextBlock Text="Apply with a click" Style="{StaticResource Tiny}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="No saved looks yet. Tune the sliders, then save one."
                                   Style="{StaticResource Tiny}" TextWrapping="Wrap" Margin="0,14,0,0"
                                   Visibility="{Binding PresetsEmpty, Converter={StaticResource BoolToVis}}" />

                        <ItemsControl ItemsSource="{Binding Presets}" Margin="0,14,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="126" Margin="0,0,6,8">
                                        <Button Style="{StaticResource PresetCardButton}" Click="Preset_Click"
                                                ToolTip="{Binding Description}"
                                                AutomationProperties.Name="{Binding Name}">
                                            <StackPanel>
                                                <Border Height="62" CornerRadius="6" Background="{Binding Preview}" />
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" Margin="2,8,2,0" />
                                                <ItemsControl ItemsSource="{Binding Swatches}" Margin="2,6,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="12" Height="4" CornerRadius="1" Background="{Binding}"
                                                                    Margin="0,0,3,0" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource DangerIconButton}" Width="30" Height="30"
                                                MinWidth="30" Padding="0" Margin="0,5,5,0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                ToolTip="Delete this look"
                                                AutomationProperties.Name="{Binding Name, StringFormat='Delete {0}'}"
                                                Click="DeletePreset_Click">
                                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="11.5" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,6,0,12" />
                        <TextBlock Text="Save current sliders as a look" Style="{StaticResource Tiny}" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="Save look" Style="{StaticResource PrimaryButton}"
                                    Margin="8,0,0,0" Click="SavePreset_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="2,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
