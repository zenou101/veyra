<UserControl x:Class="Veyra.UI.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageContent}">

            <Border Style="{StaticResource Panel}" Padding="24,18">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource AccentSoftBrush}"
                            BorderBrush="#1B5C73" BorderThickness="1" CornerRadius="6" Padding="10,6">
                        <TextBlock Text="{Binding PresetCount}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    </Border>
                </Grid>
            </Border>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="330" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Panel}" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="All looks" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Presets}" Margin="0,14,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PresetCardBorder}" Width="190" Margin="0,0,10,10"
                                            ToolTip="{Binding Description}"
                                            AutomationProperties.Name="{Binding Name}"
                                            MouseLeftButtonUp="Apply_Click">
                                        <StackPanel>
                                            <Border Height="72" CornerRadius="3" Background="{Binding Preview}" />
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Badge}" FontSize="7.5" FontWeight="Bold"
                                                               Foreground="{StaticResource TextFaintBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="&#xE74D;" FontFamily="{StaticResource IconFont}"
                                                        Style="{StaticResource SubtleButton}" FontSize="10"
                                                        VerticalAlignment="Top"
                                                        Padding="6,3" ToolTip="Delete this look"
                                                        Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"
                                                        Click="Delete_Click" />
                                            </Grid>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Tiny}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                                            <ItemsControl ItemsSource="{Binding Swatches}" Margin="0,7,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="15" Height="5" CornerRadius="1" Background="{Binding}"
                                                                Margin="0,0,3,0" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <Border Style="{StaticResource Panel}" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="Save a new look" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Reads the selected display's current driver values and stores them here."
                                       Style="{StaticResource Caption}" Margin="0,6,0,0" />
                            <TextBlock Text="Name" Style="{StaticResource Label}" Margin="0,14,0,5" />
                            <TextBox Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Display" Style="{StaticResource Label}" Margin="0,12,0,5" />
                            <ListBox ItemsSource="{Binding Displays}" SelectedItem="{Binding SelectedDisplay}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource Chip}">
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding FriendlyName}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding FriendlyName}" FontSize="11.5" />
                                            <TextBlock Text="{Binding ResolutionLabel}" FontSize="9.5" Opacity="0.75" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Content="Save current look" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left" Margin="0,14,0,0" Click="Save_Click" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Padding="20,18" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="How looks work" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Click any card to apply it to the selected display. Built-in looks are refreshed on every launch; your own looks stay until you delete them."
                                       Style="{StaticResource Caption}" Margin="0,8,0,0" />
                            <TextBlock Text="Only saturation goes through the GPU driver. Brightness, contrast, gamma, temperature, shadows and black level use the Windows ramp."
                                       Style="{StaticResource Caption}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="2,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
