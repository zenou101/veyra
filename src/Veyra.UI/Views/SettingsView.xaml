<UserControl x:Class="Veyra.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContent}">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />

            <Border Style="{StaticResource Card}" Margin="0,18,0,12">
                <StackPanel>
                    <TextBlock Text="BEHAVIOUR" Style="{StaticResource SectionTitle}" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RestoreOnExit}" Content="Restore colour settings when Veyra exits" Margin="0,4" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CloseToTray}" Content="Closing the window keeps Veyra in the tray" Margin="0,4" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartMinimized}" Content="Start minimised" Margin="0,4" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="COLOUR PROVIDERS" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding ProviderDetail}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StartupStatus}" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="ABOUT" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Veyra" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Version}" Style="{StaticResource Mono}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding Licence}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding DataFolder}" Style="{StaticResource Mono}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <Button Content="Open data folder" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OpenFolder_Click" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
