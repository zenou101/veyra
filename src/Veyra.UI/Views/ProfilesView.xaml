<UserControl x:Class="Veyra.UI.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageContent}">

            <Border Style="{StaticResource Panel}" Padding="24,18">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource AccentSoftBrush}"
                            BorderBrush="#1B5C73" BorderThickness="1" CornerRadius="6" Padding="10,6">
                        <TextBlock Text="{Binding ProfileCount}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource Panel}" Padding="24,20" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="Pick a game" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Choose the executable, give the profile a name and assign one of your looks."
                               Style="{StaticResource Tiny}" Margin="0,4,0,0" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Game name" Style="{StaticResource Label}" Margin="0,0,0,5" />
                            <TextBox Text="{Binding GameName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Executable" Style="{StaticResource Label}" Margin="0,12,0,5" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ExecutableName, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Content="Browse…" Style="{StaticResource GhostButton}"
                                        Margin="8,0,0,0" Click="Browse_Click" />
                            </Grid>

                            <TextBlock Text="Display" Style="{StaticResource Label}" Margin="0,12,0,5" />
                            <ListBox ItemsSource="{Binding Displays}" SelectedItem="{Binding SelectedDisplay}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource Chip}">
                                        <Setter Property="Margin" Value="0,0,6,6" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding FriendlyName}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FriendlyName}" FontSize="11" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Look" Style="{StaticResource Label}" Margin="0,0,0,5" />
                            <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" MaxHeight="250">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource Chip}">
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Name}" FontSize="11.5"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Description}" FontSize="9.5" Opacity="0.75"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Width="24" Height="24" CornerRadius="3" Background="{Binding Preview}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Button Content="Save profile" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                    Margin="0,12,0,0" Click="Save_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Panel}" Padding="24,20" Margin="0,10,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Saved game profiles" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Applied on request, never silently" Style="{StaticResource Tiny}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="No game profiles yet. Pick a game above, choose one of your looks and save it here."
                               Style="{StaticResource Caption}" Margin="0,14,0,8"
                               Visibility="{Binding EmptyVisibility}" />

                    <ItemsControl ItemsSource="{Binding Profiles}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InsetPanel}" Margin="0,0,0,8" Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ExecutableName}" Style="{StaticResource Tiny}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="LOOK" Style="{StaticResource Micro}" />
                                            <TextBlock Text="{Binding Detail}" FontSize="11.5" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Apply" Style="{StaticResource SmallButton}" Click="Apply_Click" />
                                            <Button Content="Delete" Style="{StaticResource DangerButton}" Margin="6,0,0,0"
                                                    Click="Delete_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Automatic process watching is not enabled in this build. A profile changes colour only when you apply it, so a game can never be changed without you seeing it."
                               Style="{StaticResource Caption}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="2,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
