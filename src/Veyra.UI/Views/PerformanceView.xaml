<UserControl x:Class="Veyra.UI.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContent}">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />

            <UniformGrid Columns="2" Margin="0,18,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,8,8">
                    <StackPanel>
                        <DockPanel><TextBlock Text="GPU UTILISATION" Style="{StaticResource Label}" /><TextBlock Text="{Binding Gpu}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontWeight="SemiBold" /></DockPanel>
                        <ProgressBar Value="{Binding GpuPercent, Mode=OneWay}" Maximum="100" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding GpuMemory}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,8">
                    <StackPanel>
                        <DockPanel><TextBlock Text="CPU" Style="{StaticResource Label}" /><TextBlock Text="{Binding Cpu}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontWeight="SemiBold" /></DockPanel>
                        <ProgressBar Value="{Binding CpuPercent, Mode=OneWay}" Maximum="100" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding Memory}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,8,8,0">
                    <StackPanel>
                        <TextBlock Text="MEMORY" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding Memory}" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <ProgressBar Value="{Binding RamPercent, Mode=OneWay}" Maximum="100" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,8,0,0">
                    <StackPanel>
                        <TextBlock Text="GPU TEMPERATURE" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding Temperature}" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Text="Not exposed by a supported sensor interface on this driver." Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="FRAME RATE" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding FpsText}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
                    <TextBlock Text="{Binding FpsDetail}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="MEASUREMENT SCOPE" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding GpuDetail}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding Source}" Style="{StaticResource Mono}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
