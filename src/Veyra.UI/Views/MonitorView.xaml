<UserControl x:Class="Veyra.UI.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Veyra.UI.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageContent}">

            <controls:PageHeader Eyebrow="MONITOR" Title="{Binding Title}" Subtitle="{Binding Subtitle}">
                <controls:PageHeader.Actions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Badge}" Margin="0,0,10,0">
                            <TextBlock Text="DDC/CI" Style="{StaticResource BadgeText}" />
                        </Border>
                        <Button Content="Restore my monitor" Style="{StaticResource SecondaryButton}" Click="Restore_Click" />
                    </StackPanel>
                </controls:PageHeader.Actions>
            </controls:PageHeader>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding MonitorName}" Style="{StaticResource PanelTitle}" />
                                    <TextBlock Text="{Binding MonitorDetail}" Style="{StaticResource Tiny}" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedDisplay.FriendlyName}" FontSize="11.5"
                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                           MaxWidth="220" TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14" />

                            <Grid>
                                <TextBlock Text="Brightness" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding Brightness, StringFormat={}{0:0} %}" Style="{StaticResource FieldValue}" />
                            </Grid>
                            <Slider Minimum="0" Maximum="100" Value="{Binding Brightness}"
                                    IsEnabled="{Binding HasBrightness}" Margin="0,4,0,14" />

                            <Grid>
                                <TextBlock Text="Contrast" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding Contrast, StringFormat={}{0:0} %}" Style="{StaticResource FieldValue}" />
                            </Grid>
                            <Slider Minimum="0" Maximum="100" Value="{Binding Contrast}"
                                    IsEnabled="{Binding HasContrast}" Margin="0,4,0,14" />

                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LowBlueLight}"
                                      Content="Low blue light" />
                            <TextBlock Text="Warmer white point for late sessions. Applies to this display through the Windows ramp."
                                       Style="{StaticResource Tiny}" Margin="0,6,0,0" />

                            <TextBlock Text="{Binding DdcDetail}" Style="{StaticResource Caption}" Margin="0,16,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="This monitor's colour" Style="{StaticResource PanelTitle}" />
                            <TextBlock Text="Windows ramp controls. They combine with the brightness and contrast above."
                                       Style="{StaticResource Tiny}" Margin="0,4,0,0" />

                            <Grid Margin="0,16,0,0">
                                <TextBlock Text="Gamma" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding GammaPercent, StringFormat={}{0:0} %}" Style="{StaticResource FieldValue}" />
                            </Grid>
                            <Slider Minimum="50" Maximum="150" Value="{Binding GammaPercent}" Margin="0,4,0,14" />

                            <Grid>
                                <TextBlock Text="Warmth" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding WarmthDetail}" Style="{StaticResource FieldValue}" />
                            </Grid>
                            <Slider Minimum="0" Maximum="100" Value="{Binding Warmth}" Margin="0,4,0,0" />
                            <Grid Margin="0,2,0,0">
                                <TextBlock Text="6500 K" Style="{StaticResource Tiny}" />
                                <TextBlock Text="3500 K" Style="{StaticResource Tiny}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="Monitor" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding MonitorName}" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding MonitorDetail}" Style="{StaticResource Tiny}" Margin="0,3,0,0"
                                       TextWrapping="Wrap" />
                            <ListBox ItemsSource="{Binding Displays}" SelectedItem="{Binding SelectedDisplay}"
                                     Margin="0,12,0,0">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource Chip}">
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding FriendlyName}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FriendlyName}" FontSize="11.5" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="What is DDC/CI?" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="DDC/CI lets software send brightness and contrast to the monitor itself, exactly like the buttons on the back. It works on most desktop monitors; some laptops and adapters do not pass it through."
                                       Style="{StaticResource Caption}" Margin="0,8,0,0" />
                            <TextBlock Text="If a write is refused, Veyra says so instead of moving the slider as if it worked."
                                       Style="{StaticResource Caption}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="2,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
