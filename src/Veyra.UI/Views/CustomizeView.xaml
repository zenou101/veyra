<UserControl x:Class="Veyra.UI.Views.CustomizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Veyra.UI.Controls">
    <UserControl.Resources>
        <Style x:Key="ModeDot" TargetType="Ellipse">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Stroke" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                    <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModeCardRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="FocusRing" CornerRadius="13" BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="1" Margin="-2" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="Root" CornerRadius="10" Background="#08131A"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageContent}">

            <controls:PageHeader Eyebrow="APPEARANCE" Title="{Binding Title}" Subtitle="{Binding Subtitle}">
                <controls:PageHeader.Actions>
                    <Border Style="{StaticResource Badge}">
                        <TextBlock Text="Saved automatically" Style="{StaticResource BadgeText}" />
                    </Border>
                </controls:PageHeader.Actions>
            </controls:PageHeader>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Colour mode" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding AppearanceModeDetail}" Style="{StaticResource Tiny}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <RadioButton GroupName="ColourMode" Style="{StaticResource ModeCardRadio}"
                                             IsChecked="{Binding IsDefaultMode, Mode=TwoWay}"
                                             AutomationProperties.Name="Default colour mode">
                                    <StackPanel>
                                        <Border Height="86" CornerRadius="6" Background="#050F16" Padding="10">
                                            <StackPanel>
                                                <Border Height="12" Background="#123241" CornerRadius="3" />
                                                <Border Height="12" Background="#0B2A3A" CornerRadius="3" Margin="0,8,0,0" />
                                                <Border Height="30" Background="#08141B" CornerRadius="3" Margin="0,8,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Grid Margin="0,10,0,0">
                                            <TextBlock Text="Default" FontSize="12.5" FontWeight="SemiBold" />
                                            <Ellipse Style="{StaticResource ModeDot}" />
                                        </Grid>
                                        <TextBlock Text="Solid panels. Your picture shows around them."
                                                   Style="{StaticResource Tiny}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Grid.Column="2" GroupName="ColourMode" Style="{StaticResource ModeCardRadio}"
                                             IsChecked="{Binding IsSlate, Mode=TwoWay}"
                                             AutomationProperties.Name="Slate colour mode">
                                    <StackPanel>
                                        <Border Height="86" CornerRadius="6" Background="#08141B" Padding="10">
                                            <StackPanel>
                                                <Border Height="12" Background="#123241" CornerRadius="3" Opacity="0.85" />
                                                <Border Height="12" Background="#0B2A3A" CornerRadius="3" Margin="0,8,0,0" Opacity="0.85" />
                                                <Border Height="30" Background="#071B26" CornerRadius="3" Margin="0,8,0,0" Opacity="0.85" />
                                            </StackPanel>
                                        </Border>
                                        <Grid Margin="0,10,0,0">
                                            <TextBlock Text="Slate (see-through)" FontSize="12.5" FontWeight="SemiBold" />
                                            <Ellipse Style="{StaticResource ModeDot}" />
                                        </Grid>
                                        <TextBlock Text="Dark matte panels. Your picture shows through them."
                                                   Style="{StaticResource Tiny}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>
                            </Grid>

                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,14" />

                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="GUI opacity" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="How solid the panels are. The picture itself never dims."
                                               Style="{StaticResource Tiny}" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding PanelOpacityDetail}" Style="{StaticResource FieldValue}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="55" Maximum="100" Value="{Binding PanelOpacityPercent}" Margin="0,8,0,0" />
                            <Grid Margin="0,2,0,0">
                                <TextBlock Text="See-through" Style="{StaticResource Tiny}" />
                                <TextBlock Text="Solid" Style="{StaticResource Tiny}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Backdrop" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="What is drawn behind the app." Style="{StaticResource Tiny}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <RadioButton Content="Petals" GroupName="Backdrop" Style="{StaticResource SegmentRadio}"
                                             IsChecked="{Binding IsBackdropPetals, Mode=TwoWay}" Margin="0,0,8,0" />
                                <RadioButton Content="Soft" GroupName="Backdrop" Style="{StaticResource SegmentRadio}"
                                             IsChecked="{Binding IsBackdropSoft, Mode=TwoWay}" Margin="0,0,8,0" />
                                <RadioButton Content="Off" GroupName="Backdrop" Style="{StaticResource SegmentRadio}"
                                             IsChecked="{Binding IsBackdropOff, Mode=TwoWay}" />
                            </StackPanel>
                            <TextBlock Text="Backdrops are drawn by Veyra and cost nothing in games. They are only visible while the app is open."
                                       Style="{StaticResource Caption}" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="Background" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding BackgroundLabel}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="PNG, JPG or BMP. Animated GIF is not supported."
                                       Style="{StaticResource Tiny}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Choose image" Style="{StaticResource PrimaryButton}" Click="Choose_Click" />
                                <Button Content="None" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Click="Clear_Click" IsEnabled="{Binding HasBackground}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Text check" Style="{StaticResource SectionTitle}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ContrastVerdict}" FontSize="11.5" Margin="7,0,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Text="{Binding ContrastLabel}" FontSize="24" FontWeight="SemiBold" Margin="0,10,0,0" />
                            <TextBlock Text="Contrast between panel text and panel background, using the WCAG ratio. 4.5 : 1 is the normal-text target."
                                       Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Where it is stored" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Appearance choices are saved with the rest of Veyra's settings. A background picture is referenced by path and is never copied or uploaded."
                                       Style="{StaticResource Caption}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="2,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
