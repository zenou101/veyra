<UserControl x:Class="Veyra.UI.Views.MoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Veyra.UI.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageContent}">

            <controls:PageHeader Eyebrow="SETTINGS" Title="{Binding Title}" Subtitle="{Binding Subtitle}">
                <controls:PageHeader.Actions>
                    <Border Style="{StaticResource Badge}">
                        <TextBlock Text="{Binding Version, StringFormat=Version {0}}" Style="{StaticResource BadgeText}" />
                    </Border>
                </controls:PageHeader.Actions>
            </controls:PageHeader>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="Behaviour" Style="{StaticResource SectionTitle}" />
                            <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0"
                                      IsChecked="{Binding Settings.RestoreOnExit}"
                                      Content="Restore colour settings when Veyra exits" />
                            <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0"
                                      IsChecked="{Binding Settings.CloseToTray}"
                                      Content="Closing the window keeps Veyra in the tray" />
                            <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0"
                                      IsChecked="{Binding Settings.StartMinimized}"
                                      Content="Start minimised" />
                            <TextBlock Text="{Binding Settings.Status}" Style="{StaticResource Caption}" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Global shortcuts" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Changes apply on save" Style="{StaticResource Tiny}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Click a shortcut field and enter a combination. Conflicts are reported, not hidden."
                                       Style="{StaticResource Caption}" Margin="0,6,0,12" />
                            <ItemsControl ItemsSource="{Binding Hotkeys.Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ActionLabel}" Style="{StaticResource FieldLabel}"
                                                       TextWrapping="Wrap" />
                                            <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Error}" Foreground="{StaticResource DangerBrush}"
                                                       Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                       Margin="10,0,0,0" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Save shortcuts" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left" Margin="0,6,0,0" Click="SaveHotkeys_Click" />
                            <TextBlock Text="{Binding Hotkeys.Status}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="About Veyra" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Veyra" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding Version}" Style="{StaticResource Mono}" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding Licence}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                            <TextBlock Text="Free software. No account, no lifetime upgrade, no telemetry."
                                       Style="{StaticResource Caption}" Margin="0,6,0,0" />
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12" />
                            <TextBlock Text="Data folder" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding DataFolder}" Style="{StaticResource Mono}" Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                            <Button Content="Open data folder" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0" Click="OpenFolder_Click" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Colour providers" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding ProviderDetail}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding StartupStatus}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Licence" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Veyra is licensed under the GNU General Public License v3.0 or later. The full text is in LICENSE at the root of the repository."
                                       Style="{StaticResource Caption}" Margin="0,8,0,0" />
                            <TextBlock Text="Copyright © 2026 zenou101." Style="{StaticResource Tiny}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
