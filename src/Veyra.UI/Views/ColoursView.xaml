<UserControl x:Class="Veyra.UI.Views.ColoursView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContent}">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />

            <Border Style="{StaticResource Card}" Margin="0,18,0,12">
                <StackPanel>
                    <TextBlock Text="DISPLAY" Style="{StaticResource Label}" />
                    <ListBox ItemsSource="{Binding Displays}" SelectedItem="{Binding SelectedDisplay}" Margin="0,6,0,0" DisplayMemberPath="FriendlyName">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding FriendlyName}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="COLOUR ADJUSTMENTS" Style="{StaticResource SectionTitle}" />
                        <Border DockPanel.Dock="Right" Background="{StaticResource AccentSoftBrush}" CornerRadius="4"
                                Padding="7,2" VerticalAlignment="Center">
                            <TextBlock Text="LIVE SLIDERS" FontSize="8.5" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrightBrush}" />
                        </Border>
                    </DockPanel>
                    <TextBlock Text="Move a slider to apply it immediately to the selected display. Restore returns to the original colours."
                               Style="{StaticResource Caption}" Margin="0,4,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="38" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Brightness" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding Brightness}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Brightness, StringFormat={}{0:0}}" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Mono}" />

                        <TextBlock Grid.Row="1" Text="Contrast" VerticalAlignment="Center" />
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding Contrast}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Contrast, StringFormat={}{0:0}}" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Mono}" />

                        <TextBlock Grid.Row="2" Text="Gamma" VerticalAlignment="Center" />
                        <Slider Grid.Row="2" Grid.Column="1" Minimum="0.5" Maximum="2.5" Value="{Binding Gamma}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Gamma, StringFormat={}{0:0.00}}" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Mono}" />

                        <TextBlock Grid.Row="3" Text="Temperature" VerticalAlignment="Center" />
                        <Slider Grid.Row="3" Grid.Column="1" Minimum="4000" Maximum="10000" Value="{Binding Temperature}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Temperature, StringFormat={}{0:0} K}" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Mono}" />

                        <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Saturation" VerticalAlignment="Center" />
                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="5" Padding="6,2" Margin="8,0,0,0">
                                <TextBlock Text="{Binding SaturationProviderLabel}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                            <TextBlock Text="{Binding SaturationRange}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="{Binding SaturationMaximum}" Value="{Binding Saturation}" IsEnabled="{Binding SaturationEnabled}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding Saturation, StringFormat={}{0:0} %}" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Mono}" />
                    </Grid>

                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SaturationOn}" IsEnabled="{Binding SaturationEnabled}"
                              Content="Saturation on" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding SaturationReason}" Style="{StaticResource Caption}" Margin="0,10,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Apply to display" Style="{StaticResource PrimaryButton}" Click="Apply_Click" />
                        <Button Content="Restore original" Margin="10,0,0,0" Click="Restore_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="PRESETS" Style="{StaticResource SectionTitle}" />
                    <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" MaxHeight="120">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Apply preset" Click="Preset_Click" />
                        <TextBlock Text="Name" VerticalAlignment="Center" Margin="12,0,6,0" />
                        <TextBox Width="150" Margin="0" VerticalContentAlignment="Center" Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Save as preset" Margin="10,0,0,0" Click="SavePreset_Click" />
                        <Button Content="Delete" Margin="10,0,0,0" IsEnabled="{Binding CanDeletePreset}" Click="DeletePreset_Click" />
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
