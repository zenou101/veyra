<UserControl x:Class="Veyra.UI.Views.DisplaysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContent}">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />

            <ItemsControl ItemsSource="{Binding Displays}" Margin="0,18,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="4" Margin="10,0,0,0" Padding="6,2">
                                                <TextBlock Text="{Binding PrimaryBadge}" FontSize="10" Foreground="{StaticResource AccentBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding Adapter}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Hdr}" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource Caption}" />
                                </Grid>

                                <TextBlock Text="Refresh rate for the current resolution" Style="{StaticResource Label}" Margin="0,14,0,6" />
                                <ListBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" DisplayMemberPath="Label" MaxHeight="120" />

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="Apply mode…" Style="{StaticResource PrimaryButton}" Click="ApplyMode_Click" />
                                    <TextBlock Text="Every change shows a 15-second confirmation with automatic rollback."
                                               Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Margin="0,4,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                    <TextBlock Text="HDR switching and Windows 11 behaviour are not verified on this build." Style="{StaticResource Caption}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
