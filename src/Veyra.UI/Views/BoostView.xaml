<UserControl x:Class="Veyra.UI.Views.BoostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageContent}">

            <Border Style="{StaticResource Panel}" Padding="24,18">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Displays}" SelectedItem="{Binding SelectedDisplay}"
                             HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource Chip}">
                                <Setter Property="Margin" Value="6,0,0,0" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding FriendlyName}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FriendlyName}" FontSize="11" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Panel}" Padding="24,20">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Dark Boost" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Deepens blacks and shadows on this display." Style="{StaticResource Tiny}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBlock Text="0 is neutral" Style="{StaticResource Tiny}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="{Binding DarkBoost, StringFormat={}{0:0}}" Style="{StaticResource BigNumber}" />
                            <TextBlock Text="%" FontSize="22" Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Bottom" Margin="3,0,0,8" />
                        </StackPanel>

                        <Border Height="120" CornerRadius="4" Margin="0,10,0,0" ClipToBounds="True">
                            <Grid>
                                <Border>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0" Color="#050B10" />
                                            <GradientStop Offset="0.55" Color="#0E7490" />
                                            <GradientStop Offset="1" Color="#1B607A" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border Width="1" Background="#5538BDF8" HorizontalAlignment="Center" />
                                <TextBlock Text="SHADOWS" Style="{StaticResource Micro}" VerticalAlignment="Bottom"
                                           Margin="12,0,0,10" />
                                <TextBlock Text="HIGHLIGHTS" Style="{StaticResource Micro}" VerticalAlignment="Bottom"
                                           HorizontalAlignment="Right" Margin="0,0,12,10" />
                            </Grid>
                        </Border>

                        <Slider Minimum="0" Maximum="100" Value="{Binding DarkBoost}" Margin="0,12,0,0" />
                        <Grid Margin="0,2,0,0">
                            <TextBlock Text="Off" Style="{StaticResource Tiny}" />
                            <TextBlock Text="Strong" Style="{StaticResource Tiny}" HorizontalAlignment="Right" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Reset dark boost" Style="{StaticResource GhostButton}" Click="ResetBoost_Click" />
                            <TextBlock Text="Uses the Windows ramp. Restore original on Display brings everything back."
                                       Style="{StaticResource Tiny}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       TextWrapping="Wrap" MaxWidth="360" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <Border Style="{StaticResource Panel}" Padding="24,20">
                        <StackPanel>
                            <TextBlock Text="Interface zoom" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Scales Veyra's own windows and controls. Game rendering is untouched."
                                       Style="{StaticResource Tiny}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ZoomDetail}" Style="{StaticResource BigNumber}" FontSize="38"
                                       Margin="0,10,0,0" />
                            <Slider Minimum="80" Maximum="125" Value="{Binding ZoomPercent}" Margin="0,8,0,0" />
                            <Grid Margin="0,2,0,0">
                                <TextBlock Text="80 %" Style="{StaticResource Tiny}" />
                                <TextBlock Text="100 %" Style="{StaticResource Tiny}" HorizontalAlignment="Center" />
                                <TextBlock Text="125 %" Style="{StaticResource Tiny}" HorizontalAlignment="Right" />
                            </Grid>
                            <Button Content="Reset to 100 %" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left" Margin="0,12,0,0" Click="ResetZoom_Click" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Padding="20,18" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="What this is not" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="This is not a screen magnifier and it does not inject into a game. Dark Boost is a colour-ramp change; zoom only affects Veyra's interface."
                                       Style="{StaticResource Caption}" Margin="0,8,0,0" />
                            <TextBlock Text="Both settings are reversible. The original ramp is captured before the first dark-boost write."
                                       Style="{StaticResource Caption}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="2,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
