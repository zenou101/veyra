<UserControl x:Class="Veyra.UI.Views.ResolutionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Veyra.UI.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageContent}">

            <controls:PageHeader Eyebrow="DISPLAY MODES" Title="{Binding Title}" Subtitle="{Binding Subtitle}">
                <controls:PageHeader.Actions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border Style="{StaticResource Badge}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Guard ready" Style="{StaticResource BadgeText}"
                                               Foreground="{StaticResource SuccessBrush}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding SelectedDisplay.FriendlyName}" FontSize="11.5"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding CurrentDetail}" Style="{StaticResource Tiny}" HorizontalAlignment="Right"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </controls:PageHeader.Actions>
            </controls:PageHeader>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Border Style="{StaticResource Panel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedDisplay.FriendlyName, StringFormat=Now on {0}}"
                                           Style="{StaticResource Tiny}" />
                                <TextBlock Text="{Binding CurrentResolution}" Style="{StaticResource BigNumber}"
                                           FontSize="40" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding CurrentDetail}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding ModeCount}" Style="{StaticResource Tiny}" Margin="0,14,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#07151E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="14,12" VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="{Binding AspectLabel}" FontSize="17" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Megapixels}" Style="{StaticResource Tiny}"
                                               HorizontalAlignment="Center" Margin="0,3,0,0" />
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,8" />
                                    <TextBlock Text="current desktop mode" Style="{StaticResource Tiny}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Panel}" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Resolution" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Lowest to highest pixel count" Style="{StaticResource Tiny}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <ListBox ItemsSource="{Binding Resolutions}" SelectedItem="{Binding SelectedResolution}"
                                     Margin="0,12,0,0">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel ItemWidth="166" /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource Chip}">
                                        <Setter Property="Margin" Value="0,0,8,8" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" FontSize="11.5" TextAlignment="Center"
                                                   HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,6,0,14" />

                            <Grid>
                                <TextBlock Text="Refresh rate" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Highest first" Style="{StaticResource Tiny}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <ListBox ItemsSource="{Binding RefreshRates}" SelectedItem="{Binding SelectedRefresh}"
                                     Margin="0,12,0,0">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel ItemWidth="100" /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource Chip}">
                                        <Setter Property="Margin" Value="0,0,8,8" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding StringFormat={}{0} hertz}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat={}{0} Hz}" FontSize="11.5"
                                                   HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Grid Margin="0,8,0,0">
                                <TextBlock Text="{Binding SelectionLabel}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" />
                                <Button Content="Apply mode" Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Right" Click="Apply_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="Quick picks" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Sets the list above. You still confirm the change." Style="{StaticResource Tiny}"
                                       Margin="0,5,0,0" />

                            <Border Style="{StaticResource InsetPanel}" Margin="0,12,0,0">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Highest refresh" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="The fastest mode this panel reports." Style="{StaticResource Tiny}" />
                                    </StackPanel>
                                    <Button Content="Use" Style="{StaticResource SmallButton}" HorizontalAlignment="Right"
                                            Click="Highest_Click" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource InsetPanel}" Margin="0,8,0,0">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Balanced 120 Hz" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="Nearest available rate to 120 Hz." Style="{StaticResource Tiny}" />
                                    </StackPanel>
                                    <Button Content="Use" Style="{StaticResource SmallButton}" HorizontalAlignment="Right"
                                            Click="Balanced_Click" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource InsetPanel}" Margin="0,8,0,0">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Battery 60 Hz" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="Nearest available rate to 60 Hz." Style="{StaticResource Tiny}" />
                                    </StackPanel>
                                    <Button Content="Use" Style="{StaticResource SmallButton}" HorizontalAlignment="Right"
                                            Click="Battery_Click" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Display" Style="{StaticResource SectionTitle}" />
                            <ListBox ItemsSource="{Binding Displays}" SelectedItem="{Binding SelectedDisplay}"
                                     Margin="0,10,0,0">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource Chip}">
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding FriendlyName}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding FriendlyName}" FontSize="11.5" />
                                            <TextBlock Text="{Binding ResolutionLabel}" FontSize="10.5" Opacity="0.75" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="HDR is read, not switched. Windows 11 is not verified."
                                       Style="{StaticResource Tiny}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="2,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
