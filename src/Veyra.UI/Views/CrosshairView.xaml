<UserControl x:Class="Veyra.UI.Views.CrosshairView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Veyra.UI.Controls">
    <UserControl.Resources>
        <Style x:Key="StyleCardItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" CornerRadius="10" Background="#07151E" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" Padding="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageContent}">

            <Border Style="{StaticResource Panel}" Padding="24,18">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}"
                              Content="Overlay" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Border Style="{StaticResource Panel}" Padding="20,18">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Preview" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Drawn on your screen, not in the game" Style="{StaticResource Tiny}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Border Background="{StaticResource CheckerBrush}" CornerRadius="4" Height="330" Margin="0,12,0,0">
                                <controls:CrosshairPreview Settings="{Binding PreviewSettings}"
                                                           Width="300" Height="300" />
                            </Border>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Size" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding Size, StringFormat={}{0:0} px}" Style="{StaticResource FieldValue}" />
                                    </Grid>
                                    <Slider Minimum="4" Maximum="64" Value="{Binding Size}" Margin="0,3,0,12" />

                                    <Grid>
                                        <TextBlock Text="Gap" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding Gap, StringFormat={}{0:0} px}" Style="{StaticResource FieldValue}" />
                                    </Grid>
                                    <Slider Minimum="0" Maximum="20" Value="{Binding Gap}" Margin="0,3,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <Grid>
                                        <TextBlock Text="Thickness" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding Thickness, StringFormat={}{0:0.#} px}" Style="{StaticResource FieldValue}" />
                                    </Grid>
                                    <Slider Minimum="1" Maximum="8" Value="{Binding Thickness}" Margin="0,3,0,12" />

                                    <Grid>
                                        <TextBlock Text="Opacity" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding Opacity, StringFormat={}{0:P0}}" Style="{StaticResource FieldValue}" />
                                    </Grid>
                                    <Slider Minimum="0.2" Maximum="1" Value="{Binding Opacity}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <TextBlock Text="Colour" Style="{StaticResource FieldLabel}" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Outline}"
                                          Content="Outline" HorizontalAlignment="Right" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Colours}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="24" Height="24" CornerRadius="4" Background="{Binding}"
                                                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" Margin="0,0,8,0"
                                                Cursor="Hand" MouseLeftButtonUp="Colour_Click"
                                                AutomationProperties.Name="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="A crosshair cannot be guaranteed above every exclusive-fullscreen game."
                               Style="{StaticResource Caption}" Margin="2,10,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <Border Style="{StaticResource Panel}" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="Style" Style="{StaticResource SectionTitle}" />
                            <ListBox ItemsSource="{Binding Styles}" SelectedItem="{Binding SelectedStyle}"
                                     ItemContainerStyle="{StaticResource StyleCardItem}" Margin="0,10,0,0">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel ItemWidth="156" /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Border Background="{StaticResource CheckerBrush}" CornerRadius="3" Height="56">
                                                <controls:CrosshairPreview Settings="{Binding Settings}" Height="50" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Tiny}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Padding="20,18" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Compatibility" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding Notes}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
