<UserControl x:Class="Veyra.UI.Views.CrosshairView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContent}">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />

            <Border Style="{StaticResource Card}" Margin="0,18,0,12">
                <StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}" Content="Show crosshair overlay" />
                    <TextBlock Text="Click-through, never activates, and stops the moment it is switched off." Style="{StaticResource Caption}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="SHAPE" Style="{StaticResource SectionTitle}" />
                    <ListBox ItemsSource="{Binding Shapes}" SelectedItem="{Binding Shape}" />

                    <TextBlock Text="COLOUR" Style="{StaticResource SectionTitle}" Margin="0,14,0,0" />
                    <ListBox ItemsSource="{Binding Colours}" SelectedItem="{Binding Colour}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="12" Height="12" CornerRadius="6" Background="{Binding}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding}" Style="{StaticResource Mono}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Size" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="4" Maximum="64" Value="{Binding Size}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Size, StringFormat={}{0:0}}" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Mono}" />

                        <TextBlock Grid.Row="1" Text="Thickness" VerticalAlignment="Center" />
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="8" Value="{Binding Thickness}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Thickness, StringFormat={}{0:0.0}}" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Mono}" />

                        <TextBlock Grid.Row="2" Text="Gap" VerticalAlignment="Center" />
                        <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="20" Value="{Binding Gap}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Gap, StringFormat={}{0:0}}" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Mono}" />

                        <TextBlock Grid.Row="3" Text="Opacity" VerticalAlignment="Center" />
                        <Slider Grid.Row="3" Grid.Column="1" Minimum="0.2" Maximum="1" Value="{Binding Opacity}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Opacity, StringFormat={}{0:0.00}}" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Mono}" />
                    </Grid>

                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Outline}" Content="Outline for contrast" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="COMPATIBILITY" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding Notes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Caption}" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
