<UserControl x:Class="Veyra.UI.Controls.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid Margin="0,0,0,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
            <TextBlock Text="{Binding Eyebrow, ElementName=Root}" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource PageTitle}"
                       Margin="0,4,0,0" />
            <TextBlock Text="{Binding Subtitle, ElementName=Root}" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <ContentPresenter Grid.Column="1" Content="{Binding Actions, ElementName=Root}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" />
    </Grid>
</UserControl>
