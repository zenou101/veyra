<Window x:Class="Veyra.UI.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Veyra" Width="1180" Height="780" MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Soft radial washes replace large blurred ellipses: no per-frame blur surfaces. -->
        <RadialGradientBrush x:Key="AmbientTealBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Offset="0" Color="#2E0E7490" />
            <GradientStop Offset="0.55" Color="#140E7490" />
            <GradientStop Offset="1" Color="#000E7490" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="AmbientBlueBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Offset="0" Color="#1A2563EB" />
            <GradientStop Offset="1" Color="#002563EB" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="BackdropCyanBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Offset="0" Color="#2438BDF8" />
            <GradientStop Offset="1" Color="#0038BDF8" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="BackdropBlueBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Offset="0" Color="#242563EB" />
            <GradientStop Offset="1" Color="#002563EB" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="PetalCyanBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Offset="0" Color="#2438BDF8" />
            <GradientStop Offset="1" Color="#0038BDF8" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="PetalBrightBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Offset="0" Color="#1F67E8F9" />
            <GradientStop Offset="1" Color="#0067E8F9" />
        </RadialGradientBrush>

        <Style x:Key="SidebarNavList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle" Value="{DynamicResource SidebarNavItem}" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Margin="0,10">
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       HorizontalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            <TextBlock Text="{Binding Title}" FontSize="10.5" FontWeight="Bold"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="3,6,3,0" LineHeight="13"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarNavItem" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="7,1" />
            <Setter Property="Foreground" Value="{StaticResource SidebarMutedBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid x:Name="NavRoot" MinHeight="62">
                            <Border x:Name="Pill" CornerRadius="10" Background="Transparent"
                                    BorderBrush="Transparent" BorderThickness="1" />
                            <Border x:Name="Bar" Width="3" Height="20" CornerRadius="2"
                                    HorizontalAlignment="Left" Margin="3,0,0,0"
                                    Background="{StaticResource SidebarAccentBrush}" Opacity="0"
                                    Effect="{StaticResource SidebarGlowEffect}" />
                            <ContentPresenter Margin="2,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource SidebarActiveGradientBrush}" />
                                <Setter TargetName="Pill" Property="BorderBrush" Value="#1B607A" />
                                <Setter TargetName="Pill" Property="Effect" Value="{StaticResource SidebarGlowEffect}" />
                                <Setter TargetName="Bar" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarMoreButton" TargetType="Button">
            <Setter Property="AutomationProperties.Name" Value="More" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource SidebarMutedBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="NavRoot" MinHeight="62" Margin="7,1">
                            <Border x:Name="Pill" CornerRadius="10" Background="Transparent"
                                    BorderBrush="Transparent" BorderThickness="1" />
                            <Border x:Name="Bar" Width="3" Height="20" CornerRadius="2"
                                    HorizontalAlignment="Left" Margin="3,0,0,0"
                                    Background="{StaticResource SidebarAccentBrush}" Opacity="0"
                                    Effect="{StaticResource SidebarGlowEffect}" />
                            <StackPanel Margin="0,10">
                                <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="More" FontSize="10.5" FontWeight="Bold" TextAlignment="Center"
                                           Margin="3,6,3,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsMoreSelected}" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource SidebarActiveGradientBrush}" />
                                <Setter TargetName="Pill" Property="BorderBrush" Value="#1B607A" />
                                <Setter TargetName="Pill" Property="Effect" Value="{StaticResource SidebarGlowEffect}" />
                                <Setter TargetName="Bar" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid RenderOptions.ClearTypeHint="Enabled">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- Original Veyra title bar and wordmark. No upgrade or lifetime control. -->
        <Border Grid.Row="0" Background="{StaticResource StatusBarGradientBrush}"
                BorderBrush="{StaticResource SidebarBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Image Width="28" Height="28" Source="/Assets/Veyra-256.png" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                            <DropShadowEffect Color="#38BDF8" BlurRadius="22" ShadowDepth="0" Opacity="0.6" />
                        </Image.Effect>
                    </Image>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Veyra" FontFamily="{StaticResource DisplayFont}" FontSize="16"
                                   FontWeight="Bold" Foreground="{StaticResource SidebarTextBrush}" />
                        <TextBlock Text="DISPLAY &amp; COLOUR" FontSize="8.5" FontWeight="Bold"
                                   Foreground="{StaticResource SidebarAccentBrush}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButton}" Click="Minimise_Click" ToolTip="Minimise">
                        <Path Width="10" Height="10" Stretch="None" StrokeThickness="1"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M0,5 L10,5" />
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" Click="Maximise_Click" ToolTip="Maximise">
                        <Path Width="10" Height="10" Stretch="None" StrokeThickness="1"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z" />
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" Click="Close_Click" ToolTip="Close" Tag="Close">
                        <Path Width="10" Height="10" Stretch="None" StrokeThickness="1"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M0,0 L10,10 M10,0 L0,10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource SidebarGradientBrush}"
                    BorderBrush="{StaticResource SidebarBorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0" Style="{StaticResource SidebarNavList}"
                             ItemsSource="{Binding MainNavigation}"
                             SelectedItem="{Binding SelectedNavigationEntry, Mode=TwoWay}"
                             Margin="0,10,0,0" VerticalAlignment="Top" />

                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <Button Style="{StaticResource SidebarMoreButton}" Click="More_Click"
                                AutomationProperties.Name="More" />
                        <TextBlock Text="{Binding Version}" FontSize="10" HorizontalAlignment="Center"
                                   Foreground="{StaticResource SidebarFaintBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="{StaticResource BgBrush}" ClipToBounds="True">
                <Image Source="{Binding BackgroundImage}" Stretch="UniformToFill" Opacity="0.34"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <Rectangle Fill="#AA050B10" />

                <Canvas IsHitTestVisible="False" ClipToBounds="True">
                    <Ellipse Width="760" Height="760" Canvas.Left="-310" Canvas.Top="-380" Fill="{StaticResource AmbientTealBrush}" />
                    <Ellipse Width="680" Height="680" Canvas.Right="-240" Canvas.Top="-300" Fill="{StaticResource AmbientBlueBrush}" />
                    <Ellipse Width="580" Height="580" Canvas.Left="280" Canvas.Bottom="-380" Fill="{StaticResource AmbientTealBrush}" />
                </Canvas>

                <Canvas IsHitTestVisible="False" ClipToBounds="True"
                        Visibility="{Binding ShowSoftBackdrop, Converter={StaticResource BoolToVis}}">
                    <Ellipse Width="900" Height="900" Canvas.Left="-330" Canvas.Top="-430" Fill="{StaticResource BackdropCyanBrush}" />
                    <Ellipse Width="760" Height="760" Canvas.Right="-260" Canvas.Bottom="-360" Fill="{StaticResource BackdropBlueBrush}" />
                </Canvas>

                <Canvas IsHitTestVisible="False" ClipToBounds="True"
                        Visibility="{Binding ShowPetalBackdrop, Converter={StaticResource BoolToVis}}">
                    <Ellipse Width="430" Height="300" Canvas.Left="90" Canvas.Top="70" Fill="{StaticResource PetalCyanBrush}"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><RotateTransform Angle="-18" /></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Width="350" Height="240" Canvas.Right="60" Canvas.Top="130" Fill="{StaticResource PetalBrightBrush}"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><RotateTransform Angle="24" /></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Width="500" Height="360" Canvas.Left="390" Canvas.Bottom="-170" Fill="{StaticResource BackdropBlueBrush}"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><RotateTransform Angle="12" /></Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>

                <ContentControl x:Name="PageHost" Content="{Binding PageHostContent}"
                                RenderOptions.ClearTypeHint="Enabled"
                                TextOptions.TextFormattingMode="Display" />
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource StatusBarGradientBrush}"
                BorderBrush="#12303D" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Style="{StaticResource StatusDot}" />
                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontSize="11.5"
                               Foreground="{StaticResource TextFaintBrush}" TextTrimming="CharacterEllipsis"
                               Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="GPL-3.0" FontSize="10" Foreground="{StaticResource TextFaintBrush}"
                               Margin="0,0,10,0" />
                    <Border Background="#08212C" CornerRadius="4" Padding="6,1">
                        <TextBlock Text="{Binding Version}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
