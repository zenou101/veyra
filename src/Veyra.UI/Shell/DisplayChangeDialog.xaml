<Window x:Class="Veyra.UI.Shell.DisplayChangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm display change" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
        WindowStyle="SingleBorderWindow">
    <StackPanel Margin="24">
        <TextBlock Text="Confirm this display change" Style="{StaticResource PageTitle}" FontSize="20" />
        <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitle}" Margin="0,8,0,0" />

        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="14" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock x:Name="CountdownText" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="DetailText" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="RevertButton" Content="Revert now" Click="Revert_Click" />
            <Button x:Name="KeepButton" Content="Keep this mode" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="Keep_Click" />
        </StackPanel>
    </StackPanel>
</Window>
